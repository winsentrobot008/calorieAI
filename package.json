{
  "name": "calorieai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:routes && npm run test:api",
    "test:routes": "node scripts/check-routes.mjs",
    "test:token-guard": "node scripts/check-token-guard.mjs",
    "test:trial-limit": "node scripts/check-trial-limit.mjs",
    "test:credit-rules": "node scripts/check-credit-rules.mjs",
    "test:api": "node scripts/smoke-api.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:visual": "playwright test e2e/smoke.spec.ts",
    "test:qa": "python ../../scripts/qa_inspect.py --url http://127.0.0.1:3100",
    "qa:ui": "python scripts/qa_ui.py --url http://127.0.0.1:3100",
    "demo:visual": "python scripts/ceo_visual_demo.py",
    "deploy:prod": "node scripts/deploy-prod.mjs",
    "prebuild": "npm run test:routes"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^10.1.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@midscene/web": "^1.12.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
