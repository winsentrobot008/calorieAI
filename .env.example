# ─── CalorieAI 环境变量配置 ─────────────────────────────────────
# 复制此文件为 .env.local 并填入真实密钥。
# ⚠️ .env.local 已通过 .gitignore 排除，严禁提交到版本控制。

# 1️⃣ Stripe 支付 (主渠道 — 多渠道支付网格)
#   支持: 国际信用卡 (Visa/Mastercard/AMEX/JCB/UnionPay) +
#         支付宝 (Alipay) +
#         微信支付 (WeChat Pay)
# 从 Stripe Dashboard 获取: https://dashboard.stripe.com/apikeys
# 生产环境用 sk_live_ / pk_live_，测试环境用 sk_test_ / pk_test_
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
# Stripe Publishable Key (前端使用，必须以 NEXT_PUBLIC_ 开头)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY_HERE
# 从 Stripe Dashboard -> Webhooks 创建 Endpoint 后获取 signing secret
#   Endpoint URL: https://你的域名/api/stripe/webhook
#   订阅事件: checkout.session.completed, customer.subscription.updated,
#             customer.subscription.deleted, invoice.payment_succeeded,
#             invoice.payment_failed
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE

# 2️⃣ PayPal 支付 (辅渠道 — PayPal 账户)
# 从 PayPal Developer Dashboard 获取:
#   https://developer.paypal.com/dashboard/applications
NEXT_PUBLIC_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET_HERE
# Sandbox: https://api-m.sandbox.paypal.com | Live: https://api-m.paypal.com
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# 3️⃣ 视觉识别 API (A → B → C 自动回退，至少配置一个)
#   A: Google Gemini Vision（推荐 - 免费额度高）
#      模型可用 GEMINI_MODEL 覆盖，默认 gemini-2.0-flash
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# GEMINI_MODEL=gemini-2.0-flash

#   B: OpenRouter 聚合视觉模型（OpenAI 兼容接口）
#      获取: https://openrouter.ai/keys
#      模型可用 OPENROUTER_MODEL 覆盖，默认 openai/gpt-4o-mini
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
# OPENROUTER_MODEL=openai/gpt-4o-mini

#   C: DeepSeek（OpenAI 兼容接口）
#      获取: https://platform.deepseek.com/api_keys
#      注意: 官方 deepseek-chat 为纯文本模型，图片输入会被拒绝；
#      请配置支持视觉的模型/网关（如 DEEPSEEK_MODEL=deepseek-vl2）或依赖 A/B 回退
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
# DEEPSEEK_MODEL=deepseek-chat

# 4️⃣ Edge-TTS 语音合成 (可选)
# 从 Azure Portal 获取 (https://portal.azure.com -> Cognitive Services -> Speech)
TTS_SUBSCRIPTION_KEY=YOUR_AZURE_TTS_KEY_HERE

# 5️⃣ OAuth 登录 (可选)
# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# 6️⃣ 持久化数据库（可选，统一数据库访问层 src/lib/db 自动选择）
#   优先级: Postgres → KV → 本地临时文件（os.tmpdir 回退，仅适合本地/单实例调试）
#   Postgres（Vercel Postgres / Neon / Supabase 均可，标准 PG 连接串）
# POSTGRES_URL=postgres://user:pass@host:5432/dbname
# DATABASE_URL=postgres://user:pass@host:5432/dbname
#   KV（Vercel KV / Upstash Redis，REST 协议；亦兼容 VERCEL_KV_REST_* / UPSTASH_REDIS_REST_*）
# KV_REST_API_URL=https://your-region.upstash.io
# KV_REST_API_TOKEN=YOUR_KV_REST_API_TOKEN_HERE
#   KV 备选：标准 Redis 连接串（若适配器支持直连 Redis）
# REDIS_URL=rediss://default:YOUR_PASSWORD@your-region.upstash.io:6379

# 7️⃣ 前端站点绝对地址（用于 Webhook 回调 / 支付成功跳转 / 链接生成）
# 生产: https://calorie-ai-seven.vercel.app （或绑定的自定义域名）
# NEXT_PUBLIC_APP_URL=https://calorie-ai-seven.vercel.app

# ─────────────────────────────────────────────────────────────────
# 注意: 不配置真实密钥时，应用以降级/演示模式运行:
#   - Stripe / PayPal  → 显示模拟支付按钮 (Mock)
#   - 图片识别         → 返回明确错误（NO_VISION_KEY / VISION_PROVIDER_ERROR），不返回 Mock 数据
#   - TTS 合成         → 返回 WAV 正弦波音频
#   - 登录             → 本地模拟
