# ─── CalorieAI 环境变量配置 ─────────────────────────────────────

# 1️⃣ Stripe 支付 (主渠道 — 信用卡 / Apple Pay / Google Pay)
# 从 Stripe Dashboard 获取: https://dashboard.stripe.com/apikeys
# 注意: 填入真实密钥前请确保 .env.local 已加入 .gitignore
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
# Stripe Publishable Key (前端使用，以 NEXT_PUBLIC_ 开头)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY_HERE
# 从 Stripe Dashboard -> Webhooks 获取 signing secret
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE

# 2️⃣ PayPal 支付 (辅渠道 — PayPal 账户)
# 从 PayPal Developer Dashboard 获取:
#   https://developer.paypal.com/dashboard/applications
NEXT_PUBLIC_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET_HERE
# Sandbox: https://api-m.sandbox.paypal.com | Live: https://api-m.paypal.com
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# 3️⃣ 视觉识别 API (至少配置一个)
# Google Gemini Flash (推荐 - 免费额度高)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# 或 OpenAI GPT-4o Vision
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# 4️⃣ Edge-TTS 语音合成 (可选)
# 从 Azure Portal 获取 (https://portal.azure.com -> Cognitive Services -> Speech)
TTS_SUBSCRIPTION_KEY=YOUR_AZURE_TTS_KEY_HERE

# 5️⃣ OAuth 登录 (可选)
# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# ─────────────────────────────────────────────────────────────────
# 注意: 不配置真实密钥时，应用以降级/演示模式运行:
#   - Stripe / PayPal  → 显示模拟支付按钮 (Mock)
#   - 图片识别         → 返回模拟数据 (Mock)
#   - TTS 合成         → 返回 WAV 正弦波音频
#   - 登录             → 本地模拟
