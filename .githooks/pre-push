#!/bin/sh
# CalorieAI quality gate — runs the route/API path check before every push.
# Blocks the push when a broken request path is found (extra safety net on top of pre-commit).
echo "🔎 [quality-gate] route/API path check (pre-push)..."
if ! node scripts/check-routes.mjs; then
  echo "❌ Route/API path check failed — fix the reported paths, then push again."
  exit 1
fi
echo "✅ Route/API path check passed."
